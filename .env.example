# 复制成 .env 后填写。真实 .env 不要提交到仓库。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# 通道 1：SimpleTex 公式识别（专用模型）
# https://simpletex.cn → 用户中心 → 用户授权令牌
# 免费额度：标准 500 次 / 轻量 1000 次
SIMPLETEX_TOKEN=
SIMPLETEX_MODEL=standard

# 通道 2：通义千问 VL（通用多模态，第二通道）
# https://bailian.console.aliyun.com → API-KEY 管理
DASHSCOPE_API_KEY=

# 端点与模型（OpenAI 兼容即可换厂商）
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3-vl-plus

# 讲解模型（可选，留空复用上面的 key）
LLM_API_KEY=
LLM_MODEL=qwen-flash
ENABLE_EXPLAIN=1
